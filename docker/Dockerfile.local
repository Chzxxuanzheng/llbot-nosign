FROM node:24-alpine3.23 AS builder

WORKDIR /app

# yarn 版本必须与 package.json 的 packageManager 字段严格一致（yarn@4.14.1），
# 否则 --immutable 会因 yarn 版本不匹配或 lockfile 校验失败而中断。
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare yarn@4.14.1 --activate && yarn --version

# 注意：.yarn/ 未纳入版本控制（见 .gitignore），CI 的全新 checkout 中不存在，
# 因此不能 COPY .yarn，否则会因源路径缺失导致构建失败。
COPY package.json yarn.lock .yarnrc.yml ./

# --mode=skip-build 跳过 postinstall（postinstall 会 npm install WebUI 前端，
# 此时 src/webui/FE 尚未复制进镜像，直接执行会失败）。前端依赖在下一步单独安装。
RUN yarn install --immutable --mode=skip-build

COPY src/webui/FE/package.json src/webui/FE/
RUN cd src/webui/FE && npm install

COPY . .

# yarn build = build:main（vite，outDir=dist/，会清空 dist）+ build-webui，
# 顺序已固化在 package.json 中：主程序先构建，前端产物随后写入 dist/webui，
# 因此最终 dist/ 同时包含 llbot.js 与 webui/index.html。
RUN yarn build && ls -la dist dist/webui


FROM node:24-alpine3.23 AS production

RUN set -eux; \
    apk update; \
    apk add --no-cache tzdata ffmpeg; \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime; \
    echo "Asia/Shanghai" > /etc/timezone; \
    rm -rf /var/cache/apk/*

WORKDIR /app/llbot

COPY --from=builder /app/dist .

COPY docker/startup.sh /startup.sh
RUN chmod +x /startup.sh

RUN touch /.dockerenv

ENTRYPOINT ["/startup.sh"]
